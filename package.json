{
  "name": "lorawan-system",
  "version": "1.0.0",
  "description": "LoRaWAN Application Server & Frontend System",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "db:up": "docker compose -f backend/docker-compose.yml up -d",
    "db:down": "docker compose -f backend/docker-compose.yml down",
    "backend:dev": "npm run start:dev --prefix backend",
    "frontend:dev": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
